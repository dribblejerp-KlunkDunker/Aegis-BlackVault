<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and device-transfer rules for Android 12+ (API 31+).
   The dossier database and the key vault are excluded from both cloud backup and
   device-to-device transfer. (Keystore keys never transfer, so a copied vault could not be decrypted anyway.)
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="aegis_blackvault.db" />
        <exclude domain="database" path="aegis_blackvault.db-shm" />
        <exclude domain="database" path="aegis_blackvault.db-wal" />
        <exclude domain="sharedpref" path="aegis_secure_vault.xml" />
        <exclude domain="sharedpref" path="aegis_ai_model_vault.xml" />
        <exclude domain="sharedpref" path="aegis_db_key.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="aegis_blackvault.db" />
        <exclude domain="database" path="aegis_blackvault.db-shm" />
        <exclude domain="database" path="aegis_blackvault.db-wal" />
        <exclude domain="sharedpref" path="aegis_secure_vault.xml" />
        <exclude domain="sharedpref" path="aegis_ai_model_vault.xml" />
        <exclude domain="sharedpref" path="aegis_db_key.xml" />
    </device-transfer>
</data-extraction-rules>
