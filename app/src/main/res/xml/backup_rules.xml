<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Android 11 and lower (API <= 30).
   allowBackup="false" is set in the manifest; these exclusions are defense in depth in case
   backup is ever re-enabled. Dossiers about people and API-key vaults must never leave the device
   through Google cloud backup or adb backup.
-->
<full-backup-content>
    <exclude domain="database" path="aegis_blackvault.db" />
    <exclude domain="database" path="aegis_blackvault.db-shm" />
    <exclude domain="database" path="aegis_blackvault.db-wal" />
    <exclude domain="sharedpref" path="aegis_secure_vault.xml" />
    <exclude domain="sharedpref" path="aegis_ai_model_vault.xml" />
    <exclude domain="sharedpref" path="aegis_db_key.xml" />
</full-backup-content>
