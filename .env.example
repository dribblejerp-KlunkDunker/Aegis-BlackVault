# AI provider API keys.
# WARNING: values set here are compiled into BuildConfig and therefore into the APK, where anyone with
# the APK can extract them. Use this only for personal debug builds. For anything you share, leave these
# as placeholders and paste keys into the in-app Key Vault, which stores them encrypted with Android Keystore.
# (A GitHub token is entered in the in-app Key Vault only, never here.)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
PERPLEXITY_API_KEY=YOUR_PERPLEXITY_API_KEY
