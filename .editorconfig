# ktlint reads these settings (https://pinterest.github.io/ktlint/latest/rules/configuration-ktlint/).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = android_studio
max_line_length = 140
# Compose functions are PascalCase by convention.
ktlint_function_naming_ignore_when_annotated_with = Composable
# Wildcard imports are used for the model and theme packages.
ktlint_standard_no-wildcard-imports = disabled
# Line length is enforced by detekt (MaxLineLength, with a baseline); ktlint still wraps at 140 when formatting.
ktlint_standard_max-line-length = disabled

[*.{yml,yaml,json,xml}]
indent_size = 2
